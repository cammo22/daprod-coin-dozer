{
  "name": "daprod-coin-dozer",
  "productName": "DaProd Coin Dozer",
  "version": "0.0.0",
  "description": "DaProd Coin Dozer: tre piani di spintori, monete che si fondono e jackpot DaProd",
  "author": "DaProd",
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "32.2.7",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "it.daprod.coindozer",
    "productName": "DaProd Coin Dozer",
    "files": ["main.js", "www/**", "build/icon.png"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": { "target": "portable", "icon": "build/icon.png" },
    "portable": { "artifactName": "DaProd-Coin-Dozer-${version}.exe" },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "identity": null
    },
    "dmg": { "artifactName": "DaProd-Coin-Dozer-${version}.dmg", "title": "DaProd Coin Dozer" }
  }
}
